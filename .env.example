# Public backend URL. Both the origin and the /api-prefixed URL are supported.
# For the backend value VITE_API_BASE_URL=http://127.0.0.1:8000/api, use:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Legacy origin-only setting (used when NEXT_PUBLIC_API_BASE_URL is absent).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# true: use frontend fixtures and local sessions; false: use the backend API.
NEXT_PUBLIC_FRONTEND_DEMO_MODE=true

# Development-only route/auth bypass. Keep false outside intentional UI review.
NEXT_PUBLIC_FRONTEND_BYPASS=false
