# Committed defaults for `next dev` only.
# Next.js loads this file when NODE_ENV=development, which `next dev` sets.
# It is NOT loaded by `next build` or `next start`, so production stays unaffected.
# Override anything here with your own .env.local, which takes precedence and stays untracked.

# Public backend origin. The documented local backend runs on port 8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# true: use frontend fixtures and local sessions; false: use the backend API.
NEXT_PUBLIC_FRONTEND_DEMO_MODE=true

# Development-only route/auth bypass so a fresh clone can review every screen
# without a backend. Any sign-in credentials are accepted while this is true.
NEXT_PUBLIC_FRONTEND_BYPASS=true
